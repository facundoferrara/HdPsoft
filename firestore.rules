rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Config (lectura pública, escritura permitida para seed/setup pre-evento) ──────
    match /config/{doc} {
      allow read: if true;
      allow write: if true; // Solo se modifica vía seed/import antes del evento o desde Console
    }

    // ── Fighters ─────────────────────────────────────────────────────────────
    match /fighters/{fighterId} {
      allow read: if true;
      // Creación y borrado permitidos (operaciones de padrón pre-evento via seed/import)
      allow create, delete: if true;
      // Solo se permiten updates al gear (tier, weapon) — no edición de identidad desde cliente
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['tier']);
    }

    // ── Rounds ───────────────────────────────────────────────────────────────
    match /rounds/{roundId} {
      allow read: if true;
      allow create: if isValidRound(request.resource.data);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'completed_at']);
      allow delete: if false;
    }

    // ── Matches ──────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isValidMatch(request.resource.data);
      allow update: if isValidMatchUpdate(request.resource.data, resource.data);
      allow delete: if false;

      // Exchanges (subcollección — solo append, no borrado)
      match /exchanges/{exchangeId} {
        allow read: if true;
        allow create: if isValidExchange(request.resource.data);
        allow update, delete: if false;
      }
    }

    // ── Leaderboard ──────────────────────────────────────────────────────────
    match /leaderboard/{fighterId} {
      allow read: if true;
      // Creación y borrado permitidos (operaciones de padrón pre-evento via seed/import)
      allow create, delete: if true;
      // Solo se permite update incremental de campos numéricos
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['total_points', 'matches_complete', 'bye_count', 'points_lost_defense']);
    }

    // ── Byes ─────────────────────────────────────────────────────────────────
    match /byes/{byeId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['fighter_id', 'round_id', 'calibration_points']);
      allow update, delete: if false;
    }

    // ── Control stats (contadores acumulados de árbitro/juez, todo el evento) ──
    match /control_stats/{fighterId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['referee_count', 'judge_count']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['referee_count', 'judge_count']);
      allow delete: if false;
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isValidRound(data) {
      return data.keys().hasAll(['round_number', 'status', 'started_at'])
          && data.round_number is int
          && data.round_number > 0
          && data.status in ['active', 'complete'];
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['round_id', 'fighter_red_id', 'fighter_blue_id', 'status', 'match_number'])
          && data.status == 'pending'
          && data.fighter_red_id != data.fighter_blue_id;
    }

    function isValidMatchUpdate(newData, oldData) {
      let changed = newData.diff(oldData).affectedKeys();
      // Activación: asignar arena
      let activationKeys = ['status', 'arena', 'activated_at'].toSet();
      // Cierre: resultado final (incluye override de mesa)
      let completionKeys = ['status', 'final_score_red', 'final_score_blue', 'winner_id',
                            'ended_early', 'ended_by_depletion',
                            'override', 'override_note', 'overridden_at'].toSet();
      // Cancelación
      let cancellationKeys = ['status'].toSet();
      // Control body update
      let controlBodyKeys = ['referee_id', 'judge_1_id', 'judge_2_id',
                              'same_club_warning', 'fairness_warning', 'role_mismatch_warning',
                              'rerolled'].toSet();
      // Si se está marcando override, exigir nota editorial no vacía
      let overrideOk = !changed.hasAny(['override'])
          || newData.override != true
          || (newData.override_note is string && newData.override_note.size() > 0);
      return overrideOk && (
             changed.hasOnly(activationKeys)
          || changed.hasOnly(completionKeys)
          || changed.hasOnly(cancellationKeys)
          || changed.hasOnly(controlBodyKeys));
    }

    function isValidExchange(data) {
      return data.keys().hasAll(['exchange_number', 'valid', 'points_delta_red', 'points_delta_blue'])
          && data.exchange_number is int
          && data.valid is bool;
    }
  }
}
